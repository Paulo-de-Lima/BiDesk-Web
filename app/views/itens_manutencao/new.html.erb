<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :create, title: "Novo item de estoque", subtitle: "Manutenção: #{@manutencao.equipamento}" do %>
    <%= render "form", item: @item, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Novo item | Manutenção | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Manutenção", path: manutencao_index_path }, { label: @manutencao.equipamento }, { label: "Novo item" }],
    title: "Produto na manutenção",
    subtitle: @manutencao.equipamento,
    icon: :estoque
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", item: @item, modal: false %>
  <% end %>
<% end %>
