<% content_for :title, "Entrar | BiDesk" %>
<% content_for :body_class, "bg-emerald-50" %>

<div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6">
  <div class="w-full max-w-md space-y-8">
    <div class="text-center">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-800 shadow-sm">
        <svg class="h-9 w-9 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="mt-6 text-3xl font-bold tracking-tight text-emerald-900">BiDesk</h1>
      <p class="mt-2 text-sm text-emerald-700/80">Sistema de gestão para sua empresa de bilhar</p>
    </div>

    <% if alert %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4" role="alert">
        <p class="text-sm font-semibold text-red-800"><%= alert %></p>
        <p class="mt-1 text-sm text-red-700">Verifique a senha e tente novamente. Se o problema persistir, contate o administrador.</p>
      </div>
    <% end %>

    <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
      <%= form_with url: login_path, local: true, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :email, "E-mail", class: ui_label_class %>
          <%= f.email_field :email,
              value: params[:email],
              class: ui_input_class,
              placeholder: "admin@bidesk.local",
              required: true,
              autofocus: true,
              autocomplete: "username" %>
        </div>
        <div>
          <%= f.label :password, "Senha", class: ui_label_class %>
          <%= f.password_field :password,
              class: ui_input_class,
              placeholder: "Digite sua senha",
              required: true,
              autocomplete: "current-password" %>
        </div>
        <%= f.submit "Entrar", class: "w-full rounded-xl bg-emerald-700 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2" %>
      <% end %>
    </div>

    <p class="text-center text-sm text-emerald-700/70">Acesso restrito ao administrador</p>
  </div>
</div>
