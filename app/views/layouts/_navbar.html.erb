<nav class="fixed top-0 z-50 w-full bg-emerald-800 text-white shadow-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex min-w-0 flex-1 items-center gap-4 md:gap-8">
      <%= link_to root_path, class: "flex shrink-0 items-center gap-2 transition hover:opacity-90" do %>
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </span>
        <span class="text-xl font-bold tracking-tight">BiDesk</span>
      <% end %>

      <div class="hidden items-center gap-1 md:flex">
        <% [
          ["Dashboard", root_path, "dashboard"],
          ["Clientes", clientes_path, "clientes"],
          ["Estoque", estoque_index_path, "estoque"],
          ["Financeiro", financeiro_index_path, "financeiro"],
          ["Manutenção", manutencao_index_path, "manutencao"]
        ].each do |label, path, name| %>
          <%= link_to label, path,
              class: "rounded-lg px-4 py-2 text-sm font-medium transition #{controller_name == name ? "bg-emerald-600 text-white" : "text-white/90 hover:bg-white/10"}" %>
        <% end %>
      </div>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-white hover:bg-white/10 md:hidden"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        aria-label="Abrir menu de navegação"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <%= link_to logout_path,
          data: { turbo_method: :delete },
          class: "hidden md:inline-flex shrink-0 items-center rounded-lg border border-white px-4 py-2 text-sm font-medium text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-emerald-800",
          aria: { label: "Sair da conta" } do %>
        Sair
      <% end %>
    </div>
  </div>

  <div id="mobile-nav-menu" class="hidden border-t border-emerald-700 bg-emerald-800 md:hidden" data-mobile-nav data-open="false">
    <div class="mx-auto max-w-7xl space-y-1 px-4 py-3 sm:px-6">
      <% [
        ["Dashboard", root_path, "dashboard"],
        ["Clientes", clientes_path, "clientes"],
        ["Estoque", estoque_index_path, "estoque"],
        ["Financeiro", financeiro_index_path, "financeiro"],
        ["Manutenção", manutencao_index_path, "manutencao"]
      ].each do |label, path, name| %>
        <%= link_to label, path,
