<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :show, title: @produto.nome, subtitle: "Detalhes do produto" do %>
    <%= render "show_details", produto: @produto %>
    <%= render "shared/modal_show_footer", edit_path: edit_estoque_path(@produto) %>
  <% end %>
<% else %>
  <% content_for :title, "#{@produto.nome} | Estoque | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Estoque", path: estoque_index_path }, { label: @produto.nome }],
    title: @produto.nome,
    subtitle: "Detalhes do produto",
    icon: :estoque
  ) %>

  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <% if @produto.estoque_baixo? %>
      <%= ui_status_badge("Estoque crítico", variant: :critical) %>
    <% else %>
      <%= ui_badge_count("Estoque normal") %>
    <% end %>
    <%= render "shared/show_actions",
        secondary: [{ label: "Editar", path: edit_estoque_path(@produto), modal: true }],
        back_path: estoque_index_path %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "show_details", produto: @produto %>
  </div>
<% end %>
