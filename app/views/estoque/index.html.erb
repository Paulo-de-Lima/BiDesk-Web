<% content_for :title, "Estoque | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Estoque" }],
  title: "Estoque",
  subtitle: "Gerencie o estoque de produtos",
  icon: :estoque
) %>

<div class="mb-5 flex flex-wrap items-center gap-2">
  <%= ui_badge_count(estoque_filtros_ativos? ? pluralize(@produtos.size, "produto encontrado", "produtos encontrados") : "Total de #{pluralize(@produtos.size, 'produto', 'produtos')}") %>
  <%= ui_filters_active_chip if estoque_filtros_ativos? %>
</div>

<div id="estoque-alerta-critico">
  <%= render "alerta_critico", produtos_baixo_estoque: @produtos_baixo_estoque %>
</div>

<%= render layout: "shared/page_toolbar" do %>
  <div class="<%= ui_toolbar_layout_class %>" data-filter-toolbar>
    <%= form_with url: estoque_index_path, method: :get, local: true, html: { class: ui_toolbar_form_class, data: { filter_form: true } } do |f| %>
      <div class="<%= ui_toolbar_search_wrapper_class %>">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </span>
        <%= f.text_field :busca, value: params[:busca], placeholder: "Buscar produtos...", class: ui_search_input_class %>
        <%= f.submit "Buscar", class: "sr-only" %>
      </div>

      <%= render "shared/filter_details",
          active: params[:categoria].present?,
          show_clear: estoque_filtros_ativos?,
          clear_path: estoque_index_path,
          clear_label: (params[:busca].present? ? "Limpar filtros e busca" : "Limpar filtros") do %>
        <%= render "shared/filter_field", label: "Categoria" do %>
          <%= f.select :categoria,
              options_for_select([["Todas as categorias", ""]] + @categorias.map { |c| [c, c] }, params[:categoria]),
              {},
              { class: "#{ui_filter_select_class} w-full", onchange: "this.form.requestSubmit()" } %>
        <% end %>
      <% end %>
    <% end %>
    <div class="<%= ui_toolbar_actions_class %>">
      <%= ui_modal_link new_estoque_path, class: "#{ui_btn_primary_class} w-full justify-center sm:w-auto" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        Novo Produto
      <% end %>
    </div>
  </div>
<% end %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th scope="col" class="<%= ui_table_th_class %>">Produto</th>
          <th scope="col" class="<%= ui_table_th_class %>">Categoria</th>
          <th scope="col" class="<%= ui_table_th_class %>">Quantidade</th>
          <th scope="col" class="<%= ui_table_th_class %>">Preço</th>
          <th scope="col" class="<%= ui_table_th_class %>">Status</th>
          <th scope="col" class="<%= ui_table_th_class %>">Ações</th>
        </tr>
      </thead>
      <tbody id="estoque_tbody" class="divide-y divide-gray-100">
        <%= render "tbody", produtos: @produtos %>
      </tbody>
    </table>
  </div>
</div>
