<% content_for :title, "Estoque | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Estoque" }],
  title: "Estoque",
  subtitle: "Gerencie o estoque de produtos",
  icon: :estoque
) %>

<div class="mb-5 flex flex-wrap items-center gap-2">
  <%= ui_badge_count(estoque_filtros_ativos? ? pluralize(@produtos.size, "produto encontrado", "produtos encontrados") : "Total de #{pluralize(@produtos.size, 'produto', 'produtos')}") %>
  <%= ui_filters_active_chip if estoque_filtros_ativos? %>
</div>

<% if @produtos_baixo_estoque.any? %>
  <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4" role="alert">
    <p class="text-sm font-medium text-red-800">
      <strong><%= @produtos_baixo_estoque.count %></strong> produto(s) com estoque abaixo do mínimo. Reponha ou ajuste o estoque mínimo.
    </p>
  </div>
<% end %>

<%= render layout: "shared/page_toolbar" do %>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between" data-filter-toolbar>
    <%= form_with url: estoque_index_path, method: :get, local: true, class: "flex min-w-0 flex-1 flex-col gap-3 sm:flex-row sm:items-center", data: { filter_form: true } do |f| %>
      <div class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </span>
        <%= f.text_field :busca, value: params[:busca], placeholder: "Buscar produtos...", class: ui_search_input_class %>
      </div>
      <%= f.select :categoria, options_for_select([["Todas as categorias", ""]] + @categorias.map { |c| [c, c] }, params[:categoria]), {}, { class: ui_select_class, onchange: "this.form.requestSubmit()" } %>
      <%= ui_filter_submit %>
      <%= ui_filter_clear(estoque_index_path) if estoque_filtros_ativos? %>
    <% end %>
    <%= ui_modal_link new_estoque_path, class: ui_btn_primary_class do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
      Novo Produto
    <% end %>
  </div>
<% end %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Produto</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Categoria</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Quantidade</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Preço</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Status</th>
          <th scope="col" class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-400">Ações</th>
        </tr>
      </thead>
      <tbody id="estoque_tbody" class="divide-y divide-gray-100">
        <%= render "tbody", produtos: @produtos %>
      </tbody>
    </table>
  </div>
</div>
