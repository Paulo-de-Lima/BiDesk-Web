<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :create, title: "Novo Produto", subtitle: "Cadastre um item no estoque" do %>
    <%= render "form", produto: @produto, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Novo Produto | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Estoque", path: estoque_index_path }, { label: "Novo" }],
    title: "Novo Produto",
    subtitle: "Cadastre um novo produto no estoque",
    icon: :estoque
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", produto: @produto, modal: false %>
  <% end %>
<% end %>
