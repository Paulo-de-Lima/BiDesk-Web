<% if modal_frame_request? %>
  <%= render "shared/modal_response", title: "Editar Produto", subtitle: @produto.nome do %>
    <%= render "form", produto: @produto, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Editar #{@produto.nome} | Estoque | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Estoque", path: estoque_index_path }, { label: @produto.nome }],
    title: "Editar Produto",
    subtitle: @produto.nome,
    icon: :estoque
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", produto: @produto, modal: false %>
  <% end %>
<% end %>
