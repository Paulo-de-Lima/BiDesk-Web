<% if modal_frame_request? %>
  <%= render "shared/modal_response", title: "Editar Transação", subtitle: @transacao.descricao do %>
    <%= render "form", transacao: @transacao, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Editar Transação | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Financeiro", path: financeiro_index_path }, { label: "Editar" }],
    title: "Editar Transação",
    subtitle: @transacao.descricao,
    icon: :financeiro
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", transacao: @transacao, modal: false %>
  <% end %>
<% end %>
