<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :create, title: "Nova Transação", subtitle: "Registre uma movimentação financeira" do %>
    <%= render "form", transacao: @transacao, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Nova Transação | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Financeiro", path: financeiro_index_path }, { label: "Nova" }],
    title: "Nova Transação",
    subtitle: "Registre uma nova movimentação financeira",
    icon: :financeiro
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", transacao: @transacao, modal: false %>
  <% end %>
<% end %>
