<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :show, title: @transacao.descricao, subtitle: "Detalhes da movimentação" do %>
    <%= render "show_details", transacao: @transacao %>
    <%= render "shared/modal_show_footer", edit_path: edit_financeiro_path(@transacao) %>
  <% end %>
<% else %>
  <% content_for :title, "Movimentação | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Financeiro", path: financeiro_index_path }, { label: @transacao.descricao.truncate(30) }],
    title: @transacao.descricao,
    subtitle: "Detalhes da movimentação financeira",
    icon: :financeiro
  ) %>

  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <span class="inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium <%= @transacao.tipo == "receita" ? "bg-emerald-100 text-emerald-800" : "bg-red-100 text-red-800" %>">
      <%= @transacao.tipo == "receita" ? "Receita" : "Despesa" %>
    </span>
    <%= render "shared/show_actions",
        secondary: [{ label: "Editar", path: edit_financeiro_path(@transacao), modal: true }],
        back_path: financeiro_index_path %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "show_details", transacao: @transacao %>
  </div>
<% end %>
