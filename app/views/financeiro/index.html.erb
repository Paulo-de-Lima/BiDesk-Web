<% content_for :title, "Financeiro | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Financeiro" }],
  title: "Financeiro",
  subtitle: "Controle financeiro da empresa",
  icon: :financeiro
) %>

<div class="mb-5 flex flex-wrap items-center gap-2">
  <%= ui_badge_count(financeiro_filtros_ativos? ? pluralize(@transacoes.size, "movimentação encontrada", "movimentações encontradas") : pluralize(@transacoes.size, "movimentação", "movimentações")) %>
  <%= ui_filters_active_chip if financeiro_filtros_ativos? %>
</div>

<div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-3">
  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm border-l-4 border-emerald-500">
    <p class="text-sm font-medium text-gray-600">Receitas do Mês</p>
    <p class="mt-2 text-3xl font-bold text-emerald-600"><%= format_currency(@receitas_mes) %></p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm border-l-4 border-red-400">
    <p class="text-sm font-medium text-gray-600">Despesas do Mês</p>
    <p class="mt-2 text-3xl font-bold text-red-600"><%= format_currency(@despesas_mes) %></p>
  </div>
  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm border-l-4 border-emerald-500">
    <p class="text-sm font-medium text-gray-600">Saldo do Mês</p>
    <p class="mt-2 text-3xl font-bold <%= @saldo_mes >= 0 ? "text-emerald-600" : "text-red-600" %>"><%= format_currency(@saldo_mes) %></p>
  </div>
</div>

<%= render layout: "shared/page_toolbar" do %>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between" data-filter-toolbar>
    <%= form_with url: financeiro_index_path, method: :get, local: true, class: "flex min-w-0 flex-1 flex-wrap items-center gap-3", data: { filter_form: true } do |f| %>
      <%= f.select :tipo, options_for_select([["Todos", ""], ["Receitas", "receita"], ["Despesas", "despesa"]], params[:tipo]), {}, { class: ui_select_class, onchange: "this.form.requestSubmit()" } %>
      <%= f.select :categoria, options_for_select([["Todas as categorias", ""]] + @categorias.map { |c| [c, c] }, params[:categoria]), {}, { class: ui_select_class, onchange: "this.form.requestSubmit()" } %>
      <%= ui_filter_submit %>
      <%= ui_filter_clear(financeiro_index_path) if financeiro_filtros_ativos? %>
    <% end %>
    <%= ui_modal_link new_financeiro_path, class: ui_btn_primary_class do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
      Nova Transação
    <% end %>
  </div>
<% end %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Data</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Tipo</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Descrição</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Categoria</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Valor</th>
          <th scope="col" class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-400">Ações</th>
        </tr>
      </thead>
      <tbody id="financeiro_tbody" class="divide-y divide-gray-100">
        <%= render "tbody", transacoes: @transacoes %>
      </tbody>
    </table>
  </div>
</div>
