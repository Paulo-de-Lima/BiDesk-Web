<%# locals: (manutencao:) %>
<% status_colors = { "pendente" => "bg-amber-100 text-amber-800", "concluida" => "bg-emerald-100 text-emerald-800" } %>
<span class="mb-4 inline-flex items-center rounded-full px-3 py-1 text-xs font-medium <%= status_colors[manutencao.status] || "bg-gray-100 text-gray-800" %>">
  <%= manutencao_status_label(manutencao.status) %>
</span>
<dl class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2">
  <div>
    <dt class="text-sm font-medium text-gray-500">Equipamento</dt>
    <dd class="mt-1 text-base font-semibold text-gray-900"><%= manutencao.equipamento %></dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-gray-500">Data</dt>
    <dd class="mt-1 text-base text-gray-900"><%= format_date(manutencao.data) %></dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-gray-500">Custo</dt>
    <dd class="mt-1 text-base font-medium text-gray-900"><%= manutencao.custo ? format_currency(manutencao.custo) : "—" %></dd>
  </div>
  <div class="sm:col-span-2">
    <dt class="text-sm font-medium text-gray-500">Descrição</dt>
    <dd class="mt-1 whitespace-pre-wrap text-base text-gray-900"><%= manutencao.descricao %></dd>
  </div>
  <% if manutencao.observacoes.present? %>
    <div class="sm:col-span-2">
      <dt class="text-sm font-medium text-gray-500">Observações</dt>
      <dd class="mt-1 whitespace-pre-wrap text-base text-gray-900"><%= manutencao.observacoes %></dd>
    </div>
  <% end %>
</dl>

<% itens = manutencao.itens_manutencao.sort_by { |i| i.produto.nome } %>
<div class="mt-8 border-t border-gray-100 pt-6">
  <h3 class="text-sm font-semibold text-emerald-900">Produtos utilizados do estoque</h3>
  <% if itens.any? %>
    <div class="mt-4 overflow-x-auto rounded-lg border border-gray-100">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50/80">
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Produto</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Qtd.</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Preço un.</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% itens.each do |item| %>
            <tr>
              <td class="<%= ui_table_td_class(compact: true) %> font-medium text-gray-800"><%= item.produto.nome %></td>
              <td class="<%= ui_table_td_class(compact: true) %> tabular-nums text-gray-900"><%= item.quantidade %></td>
              <td class="<%= ui_table_td_class(compact: true) %> text-gray-600"><%= format_currency(item.preco_unitario) %></td>
              <td class="<%= ui_table_td_class(compact: true) %> font-medium text-gray-900"><%= format_currency(item.subtotal) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-center text-sm font-medium text-gray-700">
      Total em produtos: <%= format_currency(itens.sum(&:subtotal)) %>
    </p>
  <% else %>
    <p class="mt-2 text-sm text-gray-500">Nenhum produto vinculado.</p>
  <% end %>
</div>
