<%# locals: (f:, produtos:) %>
<div class="rounded-xl border border-emerald-100 bg-emerald-50/30 p-4" data-manutencao-itens>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <div>
      <h3 class="text-sm font-semibold text-emerald-900">Produtos do estoque</h3>
      <p class="mt-0.5 text-xs text-gray-600">Selecione o que será consumido nesta manutenção. O estoque será atualizado ao salvar.</p>
    </div>
    <button type="button"
        data-manutencao-item-add
        class="inline-flex items-center gap-1 rounded-lg border border-emerald-200 bg-white px-3 py-1.5 text-xs font-semibold text-emerald-800 shadow-sm transition hover:bg-emerald-50">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      Adicionar produto
    </button>
  </div>

  <div class="space-y-3" data-manutencao-itens-list>
    <%= f.fields_for :itens_manutencao do |item_f| %>
      <%= render "manutencao/item_fields", f: item_f, produtos: produtos %>
    <% end %>
  </div>

  <template data-manutencao-item-template>
    <%= f.fields_for :itens_manutencao, ItemManutencao.new, child_index: "NEW_RECORD" do |item_f| %>
      <%= render "manutencao/item_fields", f: item_f, produtos: produtos %>
    <% end %>
  </template>
</div>
