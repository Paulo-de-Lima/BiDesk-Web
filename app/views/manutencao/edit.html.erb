<% if modal_frame_request? %>
  <%= render "shared/modal_response", title: "Editar Manutenção", subtitle: @manutencao.equipamento do %>
    <%= render "form", manutencao: @manutencao, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Editar Manutenção | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Manutenção", path: manutencao_index_path }, { label: "Editar" }],
    title: "Editar Manutenção",
    subtitle: @manutencao.equipamento,
    icon: :manutencao
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", manutencao: @manutencao, modal: false %>
  <% end %>
<% end %>
