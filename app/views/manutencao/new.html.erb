<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :create, title: "Nova Manutenção", subtitle: "Registre um serviço ou reparo" do %>
    <%= render "form", manutencao: @manutencao, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Nova Manutenção | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Manutenção", path: manutencao_index_path }, { label: "Nova" }],
    title: "Nova Manutenção",
    subtitle: "Registre uma nova manutenção",
    icon: :manutencao
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", manutencao: @manutencao, modal: false %>
  <% end %>
<% end %>
