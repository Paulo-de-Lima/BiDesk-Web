<%# locals: (manutencao:) %>
<% itens = manutencao.itens_manutencao.sort_by { |i| i.produto.nome } %>
<div class="rounded-xl border border-emerald-100 bg-white p-4 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h3 class="text-sm font-semibold text-emerald-900">Produtos utilizados do estoque</h3>
    <%= ui_modal_link new_manutencao_item_path(manutencao), class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-emerald-800" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      Novo item
    <% end %>
  </div>

  <% if itens.any? %>
    <div class="overflow-x-auto rounded-lg border border-gray-100">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50/80">
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Produto</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Quantidade</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Preço un.</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Subtotal</th>
            <th scope="col" class="<%= ui_table_th_class(compact: true) %>">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% itens.each do |item| %>
            <tr class="hover:bg-gray-50/80">
              <td class="<%= ui_table_td_class(compact: true) %> font-medium text-gray-800"><%= item.produto.nome %></td>
              <td class="<%= ui_table_td_class(compact: true) %> tabular-nums text-gray-900"><%= item.quantidade %></td>
              <td class="<%= ui_table_td_class(compact: true) %> text-gray-600"><%= format_currency(item.preco_unitario) %></td>
              <td class="<%= ui_table_td_class(compact: true) %> font-medium text-gray-900"><%= format_currency(item.subtotal) %></td>
              <td class="<%= ui_table_td_actions_class(compact: true) %>" data-no-row-nav>
                <div class="inline-flex items-center justify-center gap-1">
                  <%= link_to edit_manutencao_item_path(manutencao, item), class: "inline-flex rounded-lg p-1.5 text-amber-500 hover:bg-amber-50", title: "Editar", aria: { label: "Editar #{item.produto.nome}" }, data: ui_modal_data do %>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                  <% end %>
                  <%= button_to manutencao_item_path(manutencao, item),
                      method: :delete,
                      form: { class: "inline", data: { turbo_frame: "_top", no_submit_loading: true } },
                      class: "inline-flex cursor-pointer rounded-lg border-0 bg-transparent p-1.5 text-red-500 hover:bg-red-50",
                      title: "Excluir",
                      data: {
                        confirm_delete: true,
                        confirm_title: "Remover #{item.produto.nome}",
                        confirm_message: "«#{item.quantidade}» unidade(s) de «#{item.produto.nome}» voltarão ao estoque. Você poderá desfazer logo após confirmar."
                      } do %>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-center text-xs font-medium text-gray-600">
      Total em produtos: <span class="text-gray-900"><%= format_currency(itens.sum(&:subtotal)) %></span>
    </p>
  <% else %>
    <p class="py-6 text-center text-sm text-gray-500">Nenhum produto vinculado a esta manutenção.</p>
  <% end %>

  <div class="mt-3 flex justify-end">
    <%= ui_modal_link "Ver ficha completa", manutencao_path(manutencao), class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
  </div>
</div>
