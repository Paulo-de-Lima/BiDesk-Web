<% content_for :title, "Manutenção | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Manutenção" }],
  title: "Manutenção",
  subtitle: "Controle de manutenções dos equipamentos",
  icon: :manutencao
) %>

<div class="mb-5 flex flex-wrap items-center gap-2">
  <%= ui_badge_count(manutencao_filtros_ativos? ? pluralize(@manutencoes.count, "registro encontrado", "registros encontrados") : "Total de #{pluralize(@manutencoes.count, 'registro', 'registros')}") %>
  <%= ui_filters_active_chip if manutencao_filtros_ativos? %>
</div>

<div class="mb-8 grid grid-cols-2 gap-4 md:grid-cols-4">
  <% [
    { label: "Pendentes", value: @pendentes, color: "text-amber-600" },
    { label: "Em andamento", value: @em_andamento, color: "text-emerald-600" },
    { label: "Concluídas", value: @concluidas, color: "text-emerald-700" },
    { label: "Total", value: @manutencoes.count, color: "text-gray-900" }
  ].each do |stat| %>
    <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
      <p class="text-sm text-gray-600"><%= stat[:label] %></p>
      <p class="text-2xl font-bold <%= stat[:color] %>"><%= stat[:value] %></p>
    </div>
  <% end %>
</div>

<%= render layout: "shared/page_toolbar" do %>
  <div class="<%= ui_toolbar_layout_class %>" data-filter-toolbar>
    <%= form_with url: manutencao_index_path, method: :get, local: true, class: ui_toolbar_form_class, data: { filter_form: true } do |f| %>
      <%= f.select :status, options_for_select([["Todos os status", ""], ["Pendente", "pendente"], ["Em Andamento", "em_andamento"], ["Concluída", "concluida"], ["Cancelada", "cancelada"]], params[:status]), {}, { class: ui_filter_select_class, onchange: "this.form.requestSubmit()" } %>
      <%= f.select :equipamento, options_for_select([["Todos os equipamentos", ""]] + @equipamentos.map { |e| [e, e] }, params[:equipamento]), {}, { class: ui_filter_select_class, onchange: "this.form.requestSubmit()" } %>
      <%= ui_filter_submit %>
      <%= ui_filter_clear(manutencao_index_path) if manutencao_filtros_ativos? %>
    <% end %>
    <div class="<%= ui_toolbar_actions_class %>">
      <%= ui_modal_link new_manutencao_path, class: "#{ui_btn_primary_class} w-full justify-center sm:w-auto" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        Nova Manutenção
      <% end %>
    </div>
  </div>
<% end %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th scope="col" class="<%= ui_table_th_class %>">Equipamento</th>
          <th scope="col" class="<%= ui_table_th_class %>">Descrição</th>
          <th scope="col" class="<%= ui_table_th_class %>">Data</th>
          <th scope="col" class="<%= ui_table_th_class %>">Status</th>
          <th scope="col" class="<%= ui_table_th_class %>">Custo</th>
          <th scope="col" class="<%= ui_table_th_class(align: :right) %>">Ações</th>
        </tr>
      </thead>
      <tbody id="manutencao_tbody" class="divide-y divide-gray-100">
        <%= render "tbody", manutencoes: @manutencoes %>
      </tbody>
    </table>
  </div>
</div>
