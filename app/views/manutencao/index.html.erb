<% content_for :title, "Manutenção | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Manutenção" }],
  title: "Manutenção",
  subtitle: "Controle de manutenções dos equipamentos",
  icon: :manutencao
) %>

<div class="mb-5 flex flex-wrap items-center gap-2">
  <%= ui_badge_count(manutencao_filtros_ativos? ? pluralize(@manutencoes.count, "registro encontrado", "registros encontrados") : "Total de #{pluralize(@manutencoes.count, 'registro', 'registros')}") %>
  <%= ui_filters_active_chip if manutencao_filtros_ativos? %>
</div>

<div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <%= render "shared/metric_card",
      label: "Pendentes",
      value: @pendentes,
      accent: :amber,
      icon_path: ui_icon_path(:manutencao),
      hint: @pendentes > 0 ? "Aguardando conclusão" : "Nenhuma pendência no momento" %>
  <%= render "shared/metric_card",
      label: "Concluídas",
      value: @concluidas,
      accent: :emerald,
      icon_path: ui_icon_path(:check),
      hint: "Manutenções finalizadas" %>
  <%= render "shared/metric_card",
      label: "Exibidos",
      value: @manutencoes.count,
      accent: :neutral,
      icon_path: ui_icon_path(:manutencao),
      hint: manutencao_filtros_ativos? ? "Com filtros aplicados na lista" : "Total de registros" %>
</div>

<%= render layout: "shared/page_toolbar" do %>
  <div class="<%= ui_toolbar_layout_class %>" data-filter-toolbar>
    <%= form_with url: manutencao_index_path, method: :get, local: true, html: { class: ui_toolbar_form_class, data: { filter_form: true } } do |f| %>
      <div class="<%= ui_toolbar_search_wrapper_class %>">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </span>
        <%= f.text_field :busca, value: params[:busca], placeholder: "Buscar por equipamento ou descrição...", class: ui_search_input_class %>
        <%= f.submit "Buscar", class: "sr-only" %>
      </div>

      <%= render "shared/filter_details",
          active: manutencao_filtros_painel_ativos?,
          show_clear: manutencao_filtros_ativos?,
          clear_path: manutencao_index_path,
          clear_label: (params[:busca].present? ? "Limpar filtros e busca" : "Limpar filtros") do %>
        <%= render "shared/filter_field", label: "Status" do %>
          <%= f.select :status,
              options_for_select([["Todos os status", ""]] + manutencao_status_opcoes, params[:status]),
              {},
              { class: "#{ui_filter_select_class} w-full", onchange: "this.form.requestSubmit()" } %>
        <% end %>
        <%= render "shared/filter_field", label: "Equipamento" do %>
          <%= f.select :equipamento,
              options_for_select([["Todos os equipamentos", ""]] + @equipamentos.map { |e| [e, e] }, params[:equipamento]),
              {},
              { class: "#{ui_filter_select_class} w-full", onchange: "this.form.requestSubmit()" } %>
        <% end %>
      <% end %>
    <% end %>
    <div class="<%= ui_toolbar_actions_class %>">
      <%= ui_modal_link new_manutencao_path, class: "#{ui_btn_primary_class} w-full justify-center sm:w-auto" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        Nova Manutenção
      <% end %>
    </div>
  </div>
<% end %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th scope="col" class="<%= ui_table_th_class %>">Equipamento</th>
          <th scope="col" class="<%= ui_table_th_class %>">Descrição</th>
          <th scope="col" class="<%= ui_table_th_class %>">Data</th>
          <th scope="col" class="<%= ui_table_th_class %>">Status</th>
          <th scope="col" class="<%= ui_table_th_class %>">Custo</th>
          <th scope="col" class="<%= ui_table_th_class %>">Ações</th>
        </tr>
      </thead>
      <tbody id="manutencao_tbody" class="divide-y divide-gray-100">
        <%= render "tbody", manutencoes: @manutencoes %>
      </tbody>
    </table>
  </div>
</div>
