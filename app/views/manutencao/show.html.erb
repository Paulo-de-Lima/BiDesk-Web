<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :show, title: @manutencao.equipamento, subtitle: "Detalhes da manutenção" do %>
    <%= render "show_details", manutencao: @manutencao %>
    <%= render "shared/modal_show_footer", edit_path: edit_manutencao_path(@manutencao) %>
  <% end %>
<% else %>
  <% content_for :title, "#{@manutencao.equipamento} | Manutenção | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Manutenção", path: manutencao_index_path }, { label: @manutencao.equipamento }],
    title: @manutencao.equipamento,
    subtitle: "Detalhes da manutenção",
    icon: :manutencao
  ) %>

  <% status_colors = { "pendente" => "bg-amber-100 text-amber-800", "em_andamento" => "bg-blue-100 text-blue-800", "concluida" => "bg-emerald-100 text-emerald-800", "cancelada" => "bg-red-100 text-red-800" } %>

  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <span class="inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium <%= status_colors[@manutencao.status] || "bg-gray-100 text-gray-800" %>">
      <%= @manutencao.status.humanize %>
    </span>
    <%= render "shared/show_actions",
        secondary: [{ label: "Editar", path: edit_manutencao_path(@manutencao), modal: true }],
        back_path: manutencao_index_path %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "show_details", manutencao: @manutencao %>
  </div>
<% end %>
