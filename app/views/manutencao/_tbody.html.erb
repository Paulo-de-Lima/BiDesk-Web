<%# locals: (manutencoes:) %>
<% if manutencoes.any? %>
  <% manutencoes.each do |manutencao| %>
    <%= render "manutencao/row", manutencao: manutencao %>
  <% end %>
<% else %>
  <tr>
    <td colspan="6">
      <%= render "shared/empty_state",
          title: "Nenhuma manutenção encontrada",
          description: manutencao_filtros_ativos? ? "Tente outra busca ou ajuste os filtros." : "Registre reparos e revisões das mesas e equipamentos.",
          filtered: manutencao_filtros_ativos?,
          clear_path: manutencao_index_path,
          action_label: "Registrar manutenção",
          action_path: new_manutencao_path,
          action_modal: true,
          icon_path: ui_icon_path(:manutencao) %>
    </td>
  </tr>
<% end %>
