<%# locals: (active:, clear_path:, clear_label: "Limpar filtros", show_clear: nil) %>
<% show_clear_link = show_clear.nil? ? active : show_clear %>
<details class="filter-details relative shrink-0" data-filter-details>
  <summary class="<%= ui_filter_details_summary_class(active: active) %>">
    <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
    </svg>
    <span>Filtros</span>
    <svg class="filter-details__chevron h-4 w-4 shrink-0 text-emerald-600/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
    <% if active %>
      <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500" aria-label="Filtros ativos"></span>
    <% end %>
  </summary>
  <div class="<%= ui_filter_details_panel_class %>" data-filter-details-panel>
    <div class="<%= ui_filter_fields_stack_class %>">
      <%= yield %>
    </div>
    <% if show_clear_link %>
      <div class="<%= ui_filter_clear_wrapper_class %>">
        <%= link_to clear_label, clear_path, class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
      </div>
    <% end %>
  </div>
</details>
