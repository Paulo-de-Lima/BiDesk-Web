<%# locals: (record:, title: nil) %>
<% if record.errors.any? %>
  <div id="form-errors" class="rounded-xl border border-red-200 bg-red-50 p-4" role="alert" tabindex="-1">
    <h3 class="text-sm font-semibold text-red-800"><%= title.presence || "Corrija os erros abaixo:" %></h3>
    <ul class="mt-2 list-inside list-disc text-sm text-red-700">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
