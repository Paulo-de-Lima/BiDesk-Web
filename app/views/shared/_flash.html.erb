<% if notice || alert %>
  <% band_classes = if alert.present? && notice.blank?
       "border-b border-red-100 bg-red-50"
     else
       "bg-emerald-50"
     end %>
  <div class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] <%= band_classes %>" data-flash-container>
    <div class="mx-auto max-w-7xl space-y-3 px-4 py-3 sm:px-6 lg:px-8">
      <% if notice %>
        <div class="flex items-start justify-between gap-4 rounded-lg border border-emerald-200/80 bg-white/50 px-4 py-3 shadow-sm" role="status" data-flash>
          <div class="flex min-w-0 flex-1 flex-wrap items-center gap-3">
            <p class="text-sm font-medium text-emerald-800"><%= notice %></p>
            <% if flash[:undo_path] %>
              <%= button_to "Desfazer", flash[:undo_path], method: :post, class: "inline-flex shrink-0 items-center rounded-xl border border-emerald-200 bg-white px-3 py-1.5 text-sm font-medium text-emerald-700 transition hover:bg-emerald-100" %>
            <% end %>
          </div>
          <button type="button" data-dismiss-flash class="shrink-0 rounded-lg p-1 text-emerald-600 hover:bg-emerald-100" aria-label="Fechar mensagem">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      <% end %>
      <% if alert %>
        <div class="flex items-start justify-between gap-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 shadow-sm" role="alert" data-flash>
          <p class="text-sm font-medium text-red-800"><%= alert %></p>
          <button type="button" data-dismiss-flash class="shrink-0 rounded-lg p-1 text-red-600 hover:bg-red-100" aria-label="Fechar mensagem">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
