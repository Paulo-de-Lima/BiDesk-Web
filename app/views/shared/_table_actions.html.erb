<%# locals: (show_path:, edit_path:, destroy_path:, record_name:, confirm_detail: nil, use_modal: false) %>
<% delete_message = "Você está prestes a excluir «#{record_name}».#{" #{confirm_detail}" if confirm_detail.present?} Esta ação não pode ser desfeita." %>
<div class="inline-flex items-center justify-end gap-1" data-no-row-nav>
  <%= link_to show_path,
      class: "inline-flex rounded-lg p-2 text-blue-500 hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500",
      title: "Visualizar",
      aria: { label: "Visualizar #{record_name}" },
      data: (use_modal ? ui_modal_data : {}) do %>
    <svg class="h-5 w-5 sm:mr-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
    </svg>
  <% end %>
  <%= link_to edit_path,
      class: "inline-flex rounded-lg p-2 text-amber-500 hover:bg-amber-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500",
      title: "Editar",
      aria: { label: "Editar #{record_name}" },
      data: (use_modal ? ui_modal_data : {}) do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
    </svg>
  <% end %>
  <%= button_to destroy_path,
      method: :delete,
      form: { class: "inline" },
      class: "inline-flex cursor-pointer rounded-lg border-0 bg-transparent p-2 text-red-500 hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500",
      title: "Excluir",
      aria: { label: "Excluir #{record_name}" },
      data: {
        confirm_delete: true,
        confirm_title: "Excluir #{record_name}",
        confirm_message: delete_message
      } do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
    </svg>
  <% end %>
</div>
