<% if modal_frame_request? %>
  <%= render "shared/modal_response", title: "Editar mesa", subtitle: "#{@mesa.numeracao} — #{@cliente.nome}" do %>
    <%= render "form", mesa: @mesa, modal: true %>
  <% end %>
<% else %>
  <% content_for :title, "Editar Mesa | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Clientes", path: clientes_path }, { label: @cliente.nome, path: cliente_path(@cliente) }, { label: "Editar mesa" }],
    title: "Editar mesa de bilhar",
    subtitle: "#{@mesa.numeracao} — #{@cliente.nome}",
    icon: :mesa
  ) %>
  <%= render layout: "shared/form_card" do %>
    <%= render "form", mesa: @mesa, modal: false %>
  <% end %>
<% end %>
