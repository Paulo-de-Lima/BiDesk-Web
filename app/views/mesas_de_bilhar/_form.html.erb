<% modal = local_assigns.fetch(:modal, false) %>
<%= form_with model: mesa,
    url: mesa.persisted? ? cliente_mesa_path(@cliente, mesa) : cliente_mesas_path(@cliente),
    class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", record: mesa, title: "Não foi possível salvar:" %>

  <% if mesa.persisted? %>
    <div>
      <%= f.label :ordem, "Ordem (mesa 1, 2, 3…)", class: ui_label_class %>
      <%= f.number_field :ordem, min: 1, class: ui_field_class(mesa, :ordem), data: { field_error: mesa.errors.include?(:ordem) } %>
      <p class="mt-1 text-xs text-gray-500">Altere para reordenar as mesas deste cliente.</p>
    </div>
  <% end %>

  <div>
    <%= f.label :numeracao, "Numeração da mesa *", class: ui_label_class %>
    <%= f.text_field :numeracao, class: ui_field_class(mesa, :numeracao), placeholder: "ex.: N 300, N 25, N 234", required: true, data: { field_error: mesa.errors.include?(:numeracao) } %>
  </div>

  <div>
    <%= f.label :registros, "Registros (contagem de fichas) *", class: ui_label_class %>
    <%= f.number_field :registros, min: 0, class: ui_field_class(mesa, :registros), required: true, data: { field_error: mesa.errors.include?(:registros) } %>
    <%= render "shared/field_hint", id: "mesa-registros-hint", text: "Contador de fichas da mesa — número exibido no equipamento (ex.: 231092)." %>
  </div>

  <%= render "shared/form_actions", cancel_path: clientes_path, submit_label: mesa.persisted? ? "Atualizar" : "Salvar", modal: modal %>
<% end %>
