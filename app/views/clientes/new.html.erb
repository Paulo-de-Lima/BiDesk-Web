<% if modal_frame_request? %>
  <%= render "shared/modal_response", icon: :create, title: "Novo Cliente", subtitle: "Preencha os dados do cliente" do %>
    <%= render "form", cliente: @cliente, modal: true, submit_label: "Salvar" %>
  <% end %>
<% else %>
  <% content_for :title, "Novo Cliente | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Clientes", path: clientes_path }, { label: "Novo" }],
    title: "Novo Cliente",
    subtitle: "Cadastre um novo cliente",
    icon: :clientes
  ) %>

  <%= render layout: "shared/form_card" do %>
    <%= render "form", cliente: @cliente, modal: false, submit_label: "Salvar" %>
  <% end %>
<% end %>
