<%# Esta tela só responde dentro do turbo-frame do modal.
    Acesso direto a /clientes/:id redireciona para a lista no controller. %>
<%= render "shared/modal_response", icon: :show, title: @cliente.nome, subtitle: "Detalhes do cliente" do %>
  <%= render "show_details", cliente: @cliente %>
  <%= render "shared/modal_show_footer", edit_path: edit_cliente_path(@cliente) %>
<% end %>
