<% content_for :title, "Clientes | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Clientes" }],
  title: "Clientes",
  subtitle: "Gerencie e visualize todos os seus clientes",
  icon: :clientes
) %>

<div class="mb-5">
  <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-medium text-emerald-800">
    <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
    </svg>
    <% if params[:busca].present? || clientes_filtros_ativos? %>
      <%= pluralize(@clientes.size, "cliente encontrado", "clientes encontrados") %>
    <% else %>
      Total de <%= pluralize(@clientes.size, "cliente", "clientes") %>
    <% end %>
  </span>
</div>

<%= render layout: "shared/page_toolbar" do %>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center" data-filter-toolbar>
    <%= form_with url: clientes_path, method: :get, local: true, html: { class: "flex min-w-0 flex-1 flex-col gap-3 sm:flex-row sm:items-center", data: { filter_form: true } } do |f| %>
      <div class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
        <%= f.text_field :busca,
            value: params[:busca],
            placeholder: "Buscar por nome, telefone ou email...",
            class: ui_search_input_class %>
        <%= f.submit "Buscar", class: "sr-only" %>
      </div>

      <details class="relative shrink-0">
        <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-emerald-800 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50/50 marker:content-none focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 <%= "ring-2 ring-emerald-500/30" if clientes_filtros_ativos? %>">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
          </svg>
          Filtros
          <% if clientes_filtros_ativos? %>
            <span class="h-2 w-2 rounded-full bg-emerald-500" aria-label="Filtros ativos"></span>
          <% end %>
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-72 rounded-xl border border-gray-200 bg-white p-4 shadow-lg">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Ordenar por</p>
          <div class="space-y-2 text-sm text-gray-700">
            <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-gray-50">
              <%= radio_button_tag :ordenar, "recentes", params[:ordenar].blank? || params[:ordenar] == "recentes", class: "text-emerald-600 focus:ring-emerald-500", onchange: "this.form.requestSubmit()" %>
              <span>Mais recentes</span>
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-gray-50">
              <%= radio_button_tag :ordenar, "nome_asc", params[:ordenar] == "nome_asc", class: "text-emerald-600 focus:ring-emerald-500", onchange: "this.form.requestSubmit()" %>
              <span>Nome (A–Z)</span>
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-gray-50">
              <%= radio_button_tag :ordenar, "nome_desc", params[:ordenar] == "nome_desc", class: "text-emerald-600 focus:ring-emerald-500", onchange: "this.form.requestSubmit()" %>
              <span>Nome (Z–A)</span>
            </label>
          </div>
          <hr class="my-3 border-gray-100">
          <label class="flex cursor-pointer items-center gap-2 text-sm text-gray-700">
            <%= check_box_tag :com_email, "1", params[:com_email] == "1", class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500", onchange: "this.form.requestSubmit()" %>
            <span>Apenas com e-mail cadastrado</span>
          </label>
          <% if params[:busca].present? || clientes_filtros_ativos? %>
            <div class="mt-3 border-t border-gray-100 pt-3">
              <%= link_to "Limpar filtros e busca", clientes_path, class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <%= link_to clientes_path(clientes_export_params.merge(format: :csv)),
          class: "inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-emerald-800 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600",
          title: "Baixar lista em CSV" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        Exportar
      <% end %>

      <%= ui_modal_link new_cliente_path,
          class: "inline-flex items-center gap-2 rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Novo Cliente
      <% end %>
    </div>
  </div>
<% end %>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Nome</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Telefone</th>
          <th scope="col" class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Email</th>
          <th scope="col" class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-400">Ações</th>
        </tr>
      </thead>
      <tbody id="clientes_tbody" class="divide-y divide-gray-100">
        <%= render "tbody", clientes: @clientes %>
      </tbody>
    </table>
  </div>
</div>
