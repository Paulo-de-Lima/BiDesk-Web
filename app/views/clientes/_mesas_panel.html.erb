<%# locals: (cliente:) %>
<div class="rounded-xl border border-emerald-100 bg-white p-4 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h3 class="text-sm font-semibold text-emerald-900">Mesas de bilhar</h3>
    <%= ui_modal_link new_cliente_mesa_path(cliente), class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-emerald-800" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      Nova mesa
    <% end %>
  </div>

  <% if cliente.mesas_de_bilhar.any? %>
    <div class="overflow-x-auto rounded-lg border border-gray-100">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50/80">
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Ordem</th>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Numeração</th>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Registros</th>
            <th scope="col" class="px-4 py-2.5 text-right text-xs font-semibold uppercase tracking-wide text-gray-400">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% cliente.mesas_de_bilhar.each do |mesa| %>
            <tr class="hover:bg-gray-50/80">
              <td class="whitespace-nowrap px-4 py-2.5 font-medium text-gray-800">Mesa <%= mesa.ordem %></td>
              <td class="whitespace-nowrap px-4 py-2.5 text-gray-600"><%= mesa.numeracao %></td>
              <td class="whitespace-nowrap px-4 py-2.5 tabular-nums text-gray-900"><%= number_with_delimiter(mesa.registros, delimiter: ".") %></td>
              <td class="whitespace-nowrap px-4 py-2.5 text-right" data-no-row-nav>
                <div class="inline-flex items-center gap-1">
                  <%= link_to edit_cliente_mesa_path(cliente, mesa), class: "inline-flex rounded-lg p-1.5 text-amber-500 hover:bg-amber-50", title: "Editar", aria: { label: "Editar mesa #{mesa.numeracao}" }, data: ui_modal_data do %>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                  <% end %>
                  <%= button_to cliente_mesa_path(cliente, mesa),
                      method: :delete,
                      form: { class: "inline", data: { turbo_frame: "_top" } },
                      class: "inline-flex cursor-pointer rounded-lg border-0 bg-transparent p-1.5 text-red-500 hover:bg-red-50",
                      title: "Excluir",
                      data: {
                        confirm_delete: true,
                        confirm_title: "Excluir mesa #{mesa.numeracao}",
                        confirm_message: "A mesa «#{mesa.numeracao}» será removida permanentemente."
                      } do %>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="py-6 text-center text-sm text-gray-500">Nenhuma mesa cadastrada para este cliente.</p>
  <% end %>

  <div class="mt-3 flex justify-end">
    <%= ui_modal_link "Ver ficha completa", cliente_path(cliente), class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
  </div>
</div>
