<% if modal_frame_request? %>
  <%= render "shared/modal_response", title: "Editar Cliente", subtitle: @cliente.nome do %>
    <%= render "form", cliente: @cliente, modal: true, submit_label: "Atualizar" %>
  <% end %>
<% else %>
  <% content_for :title, "Editar #{@cliente.nome} | BiDesk" %>
  <% ui_page_shell %>
  <% ui_page_header(
    breadcrumbs: [{ label: "Dashboard", path: root_path }, { label: "Clientes", path: clientes_path }, { label: @cliente.nome }, { label: "Editar" }],
    title: "Editar Cliente",
    subtitle: @cliente.nome,
    icon: :clientes
  ) %>

  <%= render layout: "shared/form_card" do %>
    <%= render "form", cliente: @cliente, modal: false, submit_label: "Atualizar" %>
  <% end %>
<% end %>
