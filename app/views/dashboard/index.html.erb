<% content_for :title, "Dashboard | BiDesk" %>
<% ui_page_shell %>
<% ui_page_header(
  breadcrumbs: [{ label: "Dashboard" }],
  title: "Dashboard",
  subtitle: "Visão geral da sua empresa de bilhar · Última atualização: #{@ultima_atualizacao.strftime("%d/%m/%Y %H:%M")}",
  icon: :dashboard
) %>

<div data-dashboard-root data-loading="false">
  <div class="mb-5">
    <%= ui_badge_count("Resumo em tempo real") %>
  </div>

  <div class="mb-8 grid grid-cols-1 items-start gap-6 md:grid-cols-2 lg:grid-cols-4">
    <% [
      { label: "Total de Clientes", value: @total_clientes, border: "border-emerald-500", icon_bg: "bg-emerald-100", icon_color: "text-emerald-600", icon: ui_icon_path(:clientes) },
      { label: "Resultado do Mês", value: format_currency(@saldo_mes), border: @saldo_mes >= 0 ? "border-emerald-500" : "border-red-500", icon_bg: @saldo_mes >= 0 ? "bg-emerald-100" : "bg-red-100", icon_color: @saldo_mes >= 0 ? "text-emerald-600" : "text-red-600", icon: ui_icon_path(:financeiro), value_class: @saldo_mes >= 0 ? "text-emerald-600" : "text-red-600" },
      { label: "Itens em Estoque", value: @total_produtos, border: "border-amber-400", icon_bg: "bg-amber-100", icon_color: "text-amber-600", icon: ui_icon_path(:estoque), extra: @produtos_baixo_estoque > 0 ? "#{@produtos_baixo_estoque} com estoque baixo" : nil },
      { label: "Manutenções Pendentes", value: @manutencoes_pendentes, border: "border-red-400", icon_bg: "bg-red-100", icon_color: "text-red-600", icon: ui_icon_path(:manutencao) }
    ].each do |card| %>
      <div class="relative min-h-[132px] self-start rounded-2xl border border-gray-200 bg-white p-6 shadow-sm border-l-4 <%= card[:border] %>">
        <div class="dashboard-card-skeleton absolute inset-0 hidden animate-pulse rounded-2xl bg-white p-6">
          <div class="mb-3 h-4 w-1/2 rounded bg-gray-200"></div>
          <div class="h-10 w-2/3 rounded bg-gray-200"></div>
        </div>
        <div class="dashboard-card-content flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600"><%= card[:label] %></p>
            <p class="mt-2 text-3xl font-bold <%= card[:value_class] || "text-gray-900" %>"><%= card[:value] %></p>
            <% if card[:extra] %>
              <p class="mt-1 text-sm text-red-600"><%= card[:extra] %></p>
            <% end %>
            <% if card[:label] == "Resultado do Mês" && @saldo_mes < 0 %>
              <span class="mt-2 inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-700">Prejuízo no mês</span>
            <% end %>
          </div>
          <div class="<%= card[:icon_bg] %> rounded-full p-3">
            <svg class="h-8 w-8 <%= card[:icon_color] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= card[:icon] %>"></path>
            </svg>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-xl font-bold text-gray-900">Resumo Financeiro do Mês</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between rounded-xl bg-emerald-50 p-4">
          <span class="font-medium text-gray-700">Receitas</span>
          <span class="text-xl font-bold text-emerald-600"><%= format_currency(@receitas_mes) %></span>
        </div>
        <div class="flex items-center justify-between rounded-xl bg-red-50 p-4">
          <span class="font-medium text-gray-700">Despesas</span>
          <span class="text-xl font-bold text-red-600"><%= format_currency(@despesas_mes) %></span>
        </div>
        <div class="flex items-center justify-between rounded-xl border-2 border-emerald-200 bg-emerald-50/50 p-4">
          <span class="font-bold text-gray-900">Saldo</span>
          <span class="text-2xl font-bold <%= @saldo_mes >= 0 ? "text-emerald-600" : "text-red-600" %>"><%= format_currency(@saldo_mes) %></span>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-xl font-bold text-gray-900">Ações Rápidas</h2>
      <div class="grid grid-cols-2 gap-4">
        <%= ui_modal_link new_cliente_path, class: "block rounded-xl border border-emerald-100 bg-emerald-50 p-4 text-center transition hover:bg-emerald-100 min-h-[120px]" do %>
          <svg class="mx-auto mb-2 h-8 w-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
          <p class="text-sm font-medium text-gray-700">Novo Cliente</p>
        <% end %>
        <%= ui_modal_link new_estoque_path, class: "block rounded-xl border border-amber-100 bg-amber-50 p-4 text-center transition hover:bg-amber-100 min-h-[120px]" do %>
          <svg class="mx-auto mb-2 h-8 w-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
          <p class="text-sm font-medium text-gray-700">Novo Produto</p>
        <% end %>
        <button type="button" data-open-modal="nova-movimentacao-modal" class="block w-full rounded-xl border border-emerald-100 bg-emerald-50 p-4 text-center transition hover:bg-emerald-100 min-h-[120px]">
          <svg class="mx-auto mb-2 h-8 w-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
          <p class="text-sm font-medium text-gray-700">Nova Movimentação</p>
        </button>
        <%= ui_modal_link new_manutencao_path, class: "block rounded-xl border border-red-100 bg-red-50 p-4 text-center transition hover:bg-red-100 min-h-[120px]" do %>
          <svg class="mx-auto mb-2 h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
          <p class="text-sm font-medium text-gray-700">Nova Manutenção</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm lg:col-span-2">
      <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">
        <h2 class="text-xl font-bold text-gray-900">Últimas Movimentações</h2>
        <%= link_to "Ver todas →", financeiro_index_path, class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Data</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Descrição</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Valor</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if @ultimas_transacoes.any? %>
              <% @ultimas_transacoes.each do |transacao| %>
                <tr class="hover:bg-gray-50/80">
                  <td class="px-6 py-3 text-sm text-gray-900"><%= format_date(transacao.data) %></td>
                  <td class="px-6 py-3 text-sm text-gray-900"><%= transacao.descricao %></td>
                  <td class="px-6 py-3 text-sm font-medium <%= transacao.tipo == "receita" ? "text-emerald-600" : "text-red-600" %>">
                    <%= transacao.tipo == "receita" ? "+" : "-" %><%= format_currency(transacao.valor) %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="3" class="px-6 py-12 text-center text-gray-500">Nenhuma movimentação registrada</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-bold text-gray-900">Últimos Clientes</h2>
        <%= link_to "Ver todos →", clientes_path, class: "text-sm font-medium text-emerald-700 hover:text-emerald-900" %>
      </div>
      <div class="space-y-3">
        <% if @ultimos_clientes.any? %>
          <% @ultimos_clientes.each do |cliente| %>
            <div class="rounded-xl border border-gray-100 bg-gray-50 p-3">
              <p class="font-medium text-gray-900"><%= link_to cliente.nome, cliente_path(cliente), class: "text-emerald-800 hover:underline" %></p>
              <p class="text-sm text-gray-600"><%= cliente.telefone %></p>
            </div>
          <% end %>
        <% else %>
          <p class="py-4 text-center text-gray-500">Nenhum cliente cadastrado</p>
        <% end %>
      </div>
    </div>
  </div>

  <%= render layout: "shared/modal", locals: { id: "nova-movimentacao-modal", title: "Nova Movimentação", description: "Deseja iniciar uma nova movimentação financeira agora?" } do %>
    <button type="button" data-close-modal="nova-movimentacao-modal" class="rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50">Cancelar</button>
    <%= ui_modal_link "Continuar", new_financeiro_path, class: "rounded-xl bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800" %>
  <% end %>
</div>
